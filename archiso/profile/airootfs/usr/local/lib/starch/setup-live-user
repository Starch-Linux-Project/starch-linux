#!/usr/bin/env bash
set -euo pipefail
# Called inside mkarchiso's root by the live-only package hook.
[[ -f /etc/starch-live ]]
[[ -x /usr/bin/fish && -f /usr/share/wayland-sessions/cosmic.desktop ]]
if ! id liveuser &>/dev/null; then
    useradd --create-home --user-group --groups wheel --shell /usr/bin/fish --comment 'Starch Live' liveuser
fi
usermod --shell /usr/bin/fish liveuser
printf '%s\n' 'liveuser:password' | chpasswd
usermod --shell /usr/bin/bash root
live_home=$(getent passwd liveuser | cut -d: -f6)
[[ $live_home == /* && -d $live_home ]]
install -D -m 0755 -o liveuser -g liveuser /usr/share/applications/starch-install.desktop "$live_home/Desktop/starch-install.desktop"

# Resolve the same media defaults as bootstrap, after desktop files exist.
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/usr/lib/starch-installer python3 -c \
    'from pathlib import Path; from media_defaults import write_defaults; write_defaults(Path("/"))'

systemctl enable --force cosmic-greeter.service
systemctl mask greetd.service
systemctl enable power-profiles-daemon.service
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service
