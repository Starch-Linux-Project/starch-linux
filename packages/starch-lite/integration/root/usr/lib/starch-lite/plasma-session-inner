#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Own the non-systemd audio supervisor for the lifetime of this session.
set -eu
/usr/lib/starch-lite/audio-session &
audio_pid=$!
cleanup() {
    kill "$audio_pid" 2>/dev/null || :
    wait "$audio_pid" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
printf '[%s] Starch: launching startplasma-wayland.\n' "$(date --iso-8601=seconds)" >&2
status=0
/usr/bin/startplasma-wayland || status=$?
printf '[%s] Starch: startplasma-wayland exited with status %s.\n' "$(date --iso-8601=seconds)" "$status" >&2
exit "$status"
