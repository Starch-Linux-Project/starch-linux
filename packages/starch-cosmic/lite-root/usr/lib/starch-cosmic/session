#!/usr/bin/python3
"""Run the packaged Artix COSMIC session and own only its child process groups."""
import os
from pathlib import Path
import signal
import stat
import subprocess
import sys


def stop(child):
    # Children started with start_new_session=True belong to our own group.
    # COSMIC's XDG autostart children otherwise outlive cosmic-session.
    try:
        os.killpg(child.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        child.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    # Reap remaining children in this group even if its leader already exited.
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    child.wait()


def main():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/nonexistent'))
    info = runtime.stat()
    if (os.getuid() == 0 or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700):
        raise RuntimeError('COSMIC requires an owned 0700 PAM/elogind runtime directory.')
    os.environ.update(XDG_CURRENT_DESKTOP='COSMIC', XDG_SESSION_DESKTOP='COSMIC',
                      XDG_SESSION_TYPE='wayland')
    if not os.environ.get('DBUS_SESSION_BUS_ADDRESS'):
        if '--bus' in sys.argv:
            raise RuntimeError('D-Bus failed to establish the COSMIC session bus.')
        os.execv('/usr/bin/dbus-run-session',
                 ['dbus-run-session', '--', sys.executable, __file__, '--bus'])

    def interrupted(signum, _frame):
        raise SystemExit(128 + signum)

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, interrupted)
    children = []
    try:
        # Artix COSMIC has XDG autostart, but does not supervise audio itself.
        # The KDE-only starch-audio autostart is absent from this target.
        children.append(subprocess.Popen(['/usr/lib/starch-lite/audio-session'], start_new_session=True))
        children.append(subprocess.Popen(['/usr/bin/start-cosmic'], start_new_session=True))
        return children[-1].wait()
    finally:
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(signum, signal.SIG_IGN)
        for child in reversed(children):
            stop(child)


if __name__ == '__main__':
    sys.exit(main())
