From: Starch Linux Project
Subject: [PATCH] partition: constrain installer to one safe erase target

The Starch installer intentionally supports only whole-disk erase. Hide the
other partitioning paths, reject job lists that do not modify exactly one
whole disk in erase mode, and publish that canonical disk path early for the
Starch preflight module.

On BIOS systems using the required GPT partition table, add the unformatted
8 MiB BIOS Boot partition GRUB needs. The partitioning portion is adapted
from upstream commit 4e09e1ff0065c268a286da95c0425f6df26ee668, but keeps
the layout platform-specific rather than creating a hybrid layout.

Upstream-Status: Inappropriate [Starch-specific installer policy]
Origin: https://github.com/calamares/calamares/commit/4e09e1ff0065c268a286da95c0425f6df26ee668
License: GPL-3.0-or-later
---
 src/modules/partition/core/PartitionActions.cpp    | 20 +++++++
 src/modules/partition/core/PartitionCoreModule.cpp | 69 +++++++++++++++++++++-
 src/modules/partition/gui/ChoicePage.cpp           | 26 +++++++-
 3 files changed, 110 insertions(+), 5 deletions(-)

diff --git a/src/modules/partition/core/PartitionActions.cpp b/src/modules/partition/core/PartitionActions.cpp
index ddfabaf..21c6ebe 100644
--- a/src/modules/partition/core/PartitionActions.cpp
+++ b/src/modules/partition/core/PartitionActions.cpp
@@ -145,6 +145,26 @@ doAutopartition( PartitionCoreModule* core, Device* dev, Choices::AutoPartitionO
         core->createPartition( dev, efiPartition, KPM_PARTITION_FLAG_ESP );
         firstFreeSector = lastSector + 1;
     }
+    else if ( partType == PartitionTable::gpt )
+    {
+        // GRUB's i386-pc target needs embedded core-image space on GPT.
+        // Keep this platform-specific: UEFI uses the ESP above, while a
+        // legacy-BIOS boot gets only this small, unformatted partition.
+        qint64 biosSectorCount = Calamares::bytesToSectors( 8_MiB, dev->logicalSize() );
+        Q_ASSERT( biosSectorCount > 0 );
+
+        qint64 lastSector = firstFreeSector + biosSectorCount - 1;
+        Partition* biosPartition = KPMHelpers::createNewPartition( dev->partitionTable(),
+                                                                   *dev,
+                                                                   PartitionRole( PartitionRole::Primary ),
+                                                                   FileSystem::Unformatted,
+                                                                   QString(),
+                                                                   firstFreeSector,
+                                                                   lastSector,
+                                                                   KPM_PARTITION_FLAG( None ) );
+        core->createPartition( dev, biosPartition, KPM_PARTITION_FLAG( BiosGrub ) );
+        firstFreeSector = lastSector + 1;
+    }
 
     const bool mayCreateSwap
         = ( o.swap == Config::SwapChoice::SmallSwap ) || ( o.swap == Config::SwapChoice::FullSwap );
diff --git a/src/modules/partition/core/PartitionCoreModule.cpp b/src/modules/partition/core/PartitionCoreModule.cpp
index d92c66f..0f644e2 100644
--- a/src/modules/partition/core/PartitionCoreModule.cpp
+++ b/src/modules/partition/core/PartitionCoreModule.cpp
@@ -13,6 +13,9 @@
 
 #include "core/PartitionCoreModule.h"
 
+#include "GlobalStorage.h"
+#include "JobExample.h"
+#include "JobQueue.h"
 #include "core/BootLoaderModel.h"
 #include "core/ColorUtils.h"
 #include "core/DeviceList.h"
@@ -37,9 +40,6 @@
 #include "jobs/ResizeVolumeGroupJob.h"
 #include "jobs/SetPartitionFlagsJob.h"
 
-#ifdef DEBUG_PARTITION_BAIL_OUT
-#include "JobExample.h"
-#endif
 #include "partition/PartitionIterator.h"
 #include "partition/PartitionQuery.h"
 #include "utils/Logger.h"
@@ -59,6 +59,7 @@
 
 // Qt
 #include <QDir>
+#include <QFileInfo>
 #include <QFutureWatcher>
 #include <QStandardItemModel>
 #include <QtConcurrent/QtConcurrent>
@@ -649,6 +650,68 @@ PartitionCoreModule::jobs( const Config* config ) const
     Calamares::JobList lst;
     QList< Device* > devices;
 
+    // Module job lists are collected before execution begins. Publish the
+    // exact erase target now so an earlier Starch preflight job can validate
+    // it immediately before partition writes. Refuse ambiguous state here as
+    // a second line of defense behind the erase-only UI.
+    Calamares::GlobalStorage* storage = Calamares::JobQueue::instance()->globalStorage();
+    storage->remove( "starchTargetDisk" );
+
+    QList< Device* > dirtyDevices;
+    for ( const auto* info : m_deviceInfos )
+    {
+        if ( info->isDirty() )
+        {
+            dirtyDevices.append( info->device.data() );
+        }
+    }
+
+    auto failGuard = [ &lst ]( const QString& reason )
+    {
+        cError() << "Starch erase guard:" << reason;
+        lst << Calamares::job_ptr( new Calamares::FailJob( QStringLiteral( "Starch erase guard: " ) + reason ) );
+    };
+
+    if ( config->installChoice() != Config::InstallChoice::Erase )
+    {
+        failGuard( QStringLiteral( "partitioning mode is not whole-disk erase" ) );
+        return lst;
+    }
+    if ( dirtyDevices.count() != 1 )
+    {
+        failGuard( QStringLiteral( "expected exactly one modified disk, found %1" ).arg( dirtyDevices.count() ) );
+        return lst;
+    }
+
+    const QString targetNode = dirtyDevices.constFirst()->deviceNode();
+    QString targetDisk = QFileInfo( targetNode ).canonicalFilePath();
+    if ( targetDisk.isEmpty() )
+    {
+        targetDisk = targetNode;
+    }
+    if ( !targetDisk.startsWith( QStringLiteral( "/dev/" ) ) )
+    {
+        failGuard( QStringLiteral( "target is not a canonical /dev device" ) );
+        return lst;
+    }
+
+    if ( !PartUtils::isEfiSystem() )
+    {
+        QString bootDisk = QFileInfo( m_bootLoaderInstallPath ).canonicalFilePath();
+        if ( bootDisk.isEmpty() )
+        {
+            bootDisk = m_bootLoaderInstallPath;
+        }
+        if ( bootDisk != targetDisk )
+        {
+            failGuard( QStringLiteral( "BIOS bootloader target does not match erase target" ) );
+            return lst;
+        }
+    }
+
+    storage->insert( "starchTargetDisk", targetDisk );
+    cDebug() << "Starch erase target:" << targetDisk;
+
 #ifdef DEBUG_PARTITION_UNSAFE
 #ifdef DEBUG_PARTITION_BAIL_OUT
     cDebug() << "Unsafe partitioning is enabled.";
diff --git a/src/modules/partition/gui/ChoicePage.cpp b/src/modules/partition/gui/ChoicePage.cpp
index 382c1a7..ee67241 100644
--- a/src/modules/partition/gui/ChoicePage.cpp
+++ b/src/modules/partition/gui/ChoicePage.cpp
@@ -733,7 +733,22 @@ ChoicePage::onLeave()
     {
         if ( !m_isEfi )
         {
-            if ( m_bootloaderComboBox.isNull() )
+            // Starch exposes erase only. Always bind a BIOS GRUB install to
+            // the disk selected for erasure; never inherit the first disk in
+            // the bootloader combo box when another disk was selected.
+            if ( m_config->installChoice() == InstallChoice::Erase )
+            {
+                auto d_p = selectedDevice();
+                if ( d_p )
+                {
+                    m_core->setBootLoaderInstallPath( d_p->deviceNode() );
+                }
+                else
+                {
+                    cWarning() << "No erase device selected for bootloader.";
+                }
+            }
+            else if ( m_bootloaderComboBox.isNull() )
             {
                 auto d_p = selectedDevice();
                 if ( d_p )
@@ -1073,7 +1088,7 @@ ChoicePage::updateActionChoicePreview( InstallChoice choice )
         layout->addWidget( sizeLabel );
         sizeLabel->setWordWrap( true );
 
-        if ( !m_isEfi )
+        if ( !m_isEfi && choice != InstallChoice::Erase )
         {
             layout->addWidget( createBootloaderPanel() );
         }
@@ -1461,6 +1476,13 @@ ChoicePage::setupActions()
         force_uncheck( m_grp, m_replaceButton );
     }
 
+    // This installer deliberately supports whole-disk erase only. Keep no
+    // alternate path to partition writes in the UI; jobs() enforces the same
+    // invariant before it returns any destructive jobs.
+    force_uncheck( m_grp, m_alongsideButton );
+    force_uncheck( m_grp, m_replaceButton );
+    force_uncheck( m_grp, m_somethingElseButton );
+
     if ( m_somethingElseButton->isHidden() && m_alongsideButton->isHidden() && m_replaceButton->isHidden()
          && m_eraseButton->isHidden() )
     {
