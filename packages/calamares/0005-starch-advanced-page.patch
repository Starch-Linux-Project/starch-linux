new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/starchadvanced.schema.yaml
@@ -0,0 +1,5 @@
+$schema: http://json-schema.org/draft-07/schema#
+type: object
+additionalProperties: false
+properties:
+  liteEnabled: { type: boolean, default: false }
