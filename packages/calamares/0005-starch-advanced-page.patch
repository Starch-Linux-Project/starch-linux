From: Starch Linux Project
Subject: [PATCH] Present three exclusive Installation Profiles

Reuse the existing Qt Widgets module and installer storage contract.
The internal starchadvanced module name is retained for packaging compatibility.

Upstream-Status: Inappropriate [Starch-specific presentation]
License: GPL-3.0-or-later
---
diff --git a/src/modules/starchadvanced/CMakeLists.txt b/src/modules/starchadvanced/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/CMakeLists.txt
@@ -0,0 +1,9 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+include_directories(${PROJECT_BINARY_DIR}/src/libcalamaresui)
+calamares_add_plugin(starchadvanced
+    TYPE viewmodule
+    EXPORT_MACRO PLUGINDLLEXPORT_PRO
+    SOURCES AdvancedViewStep.cpp
+    UI
+    SHARED_LIB
+)
diff --git a/src/modules/starchadvanced/AdvancedViewStep.h b/src/modules/starchadvanced/AdvancedViewStep.h
new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/AdvancedViewStep.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef STARCH_ADVANCEDVIEWSTEP_H
+#define STARCH_ADVANCEDVIEWSTEP_H
+
+#include "DllMacro.h"
+#include "utils/PluginFactory.h"
+#include "viewpages/ViewStep.h"
+
+#include <QPointer>
+#include <QWidget>
+#include <QRadioButton>
+
+class PLUGINDLLEXPORT AdvancedViewStep : public Calamares::ViewStep
+{
+    Q_OBJECT
+
+public:
+    explicit AdvancedViewStep( QObject* parent = nullptr );
+    ~AdvancedViewStep() override;
+    QString prettyName() const override;
+    QWidget* widget() override;
+    QString prettyStatus() const override;
+    void setConfigurationMap( const QVariantMap& configurationMap ) override;
+    bool isNextEnabled() const override { return true; }
+    bool isBackEnabled() const override { return true; }
+    bool isAtBeginning() const override { return true; }
+    bool isAtEnd() const override { return true; }
+    Calamares::JobList jobs() const override { return {}; }
+
+private:
+    void saveSelection();
+    bool m_liteAvailable = false;
+    QPointer< QWidget > m_widget;
+    QPointer< QRadioButton > m_lite;
+    QPointer< QRadioButton > m_plasma;
+    QPointer< QRadioButton > m_cosmic;
+};
+CALAMARES_PLUGIN_FACTORY_DECLARATION( AdvancedViewStepFactory )
+#endif
diff --git a/src/modules/starchadvanced/AdvancedViewStep.cpp b/src/modules/starchadvanced/AdvancedViewStep.cpp
new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/AdvancedViewStep.cpp
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "AdvancedViewStep.h"
+#include "GlobalStorage.h"
+#include "JobQueue.h"
+
+#include <QButtonGroup>
+#include <QFrame>
+#include <QLabel>
+#include <QRadioButton>
+#include <QVBoxLayout>
+
+CALAMARES_PLUGIN_FACTORY_DEFINITION( AdvancedViewStepFactory, registerPlugin< AdvancedViewStep >(); )
+
+AdvancedViewStep::AdvancedViewStep( QObject* parent )
+    : Calamares::ViewStep( parent )
+{
+}
+
+AdvancedViewStep::~AdvancedViewStep()
+{
+    if ( m_widget && !m_widget->parent() ) m_widget->deleteLater();
+}
+
+QString
+AdvancedViewStep::prettyName() const
+{
+    return tr( "Installation Profiles" );
+}
+
+QWidget*
+AdvancedViewStep::widget()
+{
+    if ( !m_widget )
+    {
+        m_widget = new QWidget;
+        m_widget->setObjectName( "starchProfilesPage" );
+        auto* layout = new QVBoxLayout( m_widget );
+        layout->setContentsMargins( 24, 16, 24, 16 );
+        layout->setSpacing( 12 );
+        auto* subtitle = new QLabel( tr( "Choose the Starch Linux experience that's right for you." ), m_widget );
+        subtitle->setWordWrap( true );
+        layout->addWidget( subtitle );
+        auto* group = new QButtonGroup( m_widget );
+        group->setExclusive( true );
+        auto addProfile = [&]( const QString& name, const QString& title, const QString& details,
+                               const QString& description ) {
+            auto* card = new QFrame( m_widget );
+            card->setObjectName( "installationProfile" );
+            auto* cardLayout = new QVBoxLayout( card );
+            auto* button = new QRadioButton( title, card );
+            button->setObjectName( name );
+            group->addButton( button );
+            cardLayout->addWidget( button );
+            for ( const auto& text : { details, description } )
+            {
+                auto* label = new QLabel( text, card );
+                label->setWordWrap( true );
+                cardLayout->addWidget( label );
+            }
+            layout->addWidget( card );
+            connect( button, &QRadioButton::toggled, this, [this]( bool checked ) {
+                if ( checked ) saveSelection();
+            } );
+            return button;
+        };
+        m_plasma = addProfile( "starchPlasma", tr( "KDE Plasma LTS — Recommended" ),
+            tr( "Desktop: KDE Plasma · Kernel: Linux LTS · Init: systemd" ),
+            tr( "Starch's most established and thoroughly tested configuration. Recommended for the most reliable everyday desktop experience." ) );
+        m_cosmic = addProfile( "starchCosmic", tr( "COSMIC LTS" ),
+            tr( "Desktop: COSMIC · Kernel: Linux LTS · Init: systemd" ),
+            tr( "A modern desktop experience featuring COSMIC 1.x. Some features and integrations may be less mature than KDE Plasma." ) );
+        m_lite = addProfile( "starchLite", tr( "Starch Lite — For experienced users" ),
+            tr( "Desktop: XFCE · Kernel: Linux Zen · Init: OpenRC" ),
+            tr( "Starch's lightest and most extensively optimized configuration. Designed for experienced users comfortable with more hands-on system management." ) );
+        m_lite->setEnabled( m_liteAvailable );
+        if ( !m_liteAvailable )
+        {
+            auto* status = new QLabel( tr( "Starch Lite is unavailable because its package bundle is missing." ), m_widget );
+            status->setObjectName( "profileUnavailable" );
+            status->setWordWrap( true );
+            layout->addWidget( status );
+        }
+        layout->addStretch();
+        m_plasma->setChecked( true );
+    }
+    return m_widget;
+}
+
+void
+AdvancedViewStep::setConfigurationMap( const QVariantMap& configurationMap )
+{
+    Calamares::ViewStep::setConfigurationMap( configurationMap );
+    m_liteAvailable = configurationMap.value( "liteEnabled", false ).toBool();
+    if ( m_lite )
+    {
+        m_lite->setEnabled( m_liteAvailable );
+        if ( !m_liteAvailable && m_lite->isChecked() ) m_plasma->setChecked( true );
+    }
+    saveSelection();
+}
+
+void
+AdvancedViewStep::saveSelection()
+{
+    auto* storage = Calamares::JobQueue::instance()->globalStorage();
+    const bool lite = m_liteAvailable && m_lite && m_lite->isChecked();
+    const bool cosmic = m_cosmic && m_cosmic->isChecked();
+    const QString desktop = lite ? "xfce" : ( cosmic ? "cosmic" : "plasma" );
+    storage->insert( "starchLite", lite );
+    storage->insert( "starchDesktop", desktop );
+    storage->insert( "starchLiteXfce", lite );
+}
+
+QString
+AdvancedViewStep::prettyStatus() const
+{
+    if ( m_liteAvailable && m_lite && m_lite->isChecked() )
+        return tr( "Starch Lite: XFCE, Linux Zen and OpenRC." );
+    if ( m_cosmic && m_cosmic->isChecked() )
+        return tr( "COSMIC LTS: COSMIC, Linux LTS and systemd." );
+    return tr( "KDE Plasma LTS: KDE Plasma, Linux LTS and systemd." );
+}
