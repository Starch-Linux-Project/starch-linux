From: Starch Linux Project
Subject: [PATCH] Add Advanced warning and Starch Lite profile

Provide a native Qt Widgets page with an acknowledgement before showing
advanced options. Starch Lite is optional, unchecked by default, and available
when the normal ISO build stages its verified package bundle.

Upstream-Status: Inappropriate [Starch-specific presentation]
License: GPL-3.0-or-later
---
diff --git a/src/modules/starchadvanced/CMakeLists.txt b/src/modules/starchadvanced/CMakeLists.txt
new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/CMakeLists.txt
@@ -0,0 +1,9 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+include_directories(${PROJECT_BINARY_DIR}/src/libcalamaresui)
+calamares_add_plugin(starchadvanced
+    TYPE viewmodule
+    EXPORT_MACRO PLUGINDLLEXPORT_PRO
+    SOURCES AdvancedViewStep.cpp
+    UI
+    SHARED_LIB
+)
diff --git a/src/modules/starchadvanced/AdvancedViewStep.h b/src/modules/starchadvanced/AdvancedViewStep.h
new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/AdvancedViewStep.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef STARCH_ADVANCEDVIEWSTEP_H
+#define STARCH_ADVANCEDVIEWSTEP_H
+
+#include "DllMacro.h"
+#include "utils/PluginFactory.h"
+#include "viewpages/ViewStep.h"
+
+#include <QPointer>
+#include <QWidget>
+#include <QCheckBox>
+
+class PLUGINDLLEXPORT AdvancedViewStep : public Calamares::ViewStep
+{
+    Q_OBJECT
+
+public:
+    explicit AdvancedViewStep( QObject* parent = nullptr );
+    ~AdvancedViewStep() override;
+    QString prettyName() const override;
+    QWidget* widget() override;
+    QString prettyStatus() const override;
+    void setConfigurationMap( const QVariantMap& configurationMap ) override;
+    bool isNextEnabled() const override { return true; }
+    bool isBackEnabled() const override { return true; }
+    bool isAtBeginning() const override { return true; }
+    bool isAtEnd() const override { return true; }
+    Calamares::JobList jobs() const override { return {}; }
+
+private:
+    void saveSelection();
+    bool m_liteAvailable = false;
+    QPointer< QWidget > m_widget;
+    QPointer< QCheckBox > m_acknowledge;
+    QPointer< QCheckBox > m_lite;
+    QPointer< QCheckBox > m_xfce;
+};
+CALAMARES_PLUGIN_FACTORY_DECLARATION( AdvancedViewStepFactory )
+#endif
diff --git a/src/modules/starchadvanced/AdvancedViewStep.cpp b/src/modules/starchadvanced/AdvancedViewStep.cpp
new file mode 100644
--- /dev/null
+++ b/src/modules/starchadvanced/AdvancedViewStep.cpp
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "AdvancedViewStep.h"
+#include "GlobalStorage.h"
+#include "JobQueue.h"
+
+#include <QCheckBox>
+#include <QFrame>
+#include <QGroupBox>
+#include <QGraphicsBlurEffect>
+#include <QGridLayout>
+#include <QLabel>
+#include <QVBoxLayout>
+
+CALAMARES_PLUGIN_FACTORY_DEFINITION( AdvancedViewStepFactory, registerPlugin< AdvancedViewStep >(); )
+
+AdvancedViewStep::AdvancedViewStep( QObject* parent )
+    : Calamares::ViewStep( parent )
+{
+}
+
+AdvancedViewStep::~AdvancedViewStep()
+{
+    if ( m_widget && !m_widget->parent() )
+    {
+        m_widget->deleteLater();
+    }
+}
+
+QString
+AdvancedViewStep::prettyName() const
+{
+    return tr( "Advanced" );
+}
+
+QWidget*
+AdvancedViewStep::widget()
+{
+    if ( !m_widget )
+    {
+        m_widget = new QWidget;
+        m_widget->setObjectName( "starchAdvancedPage" );
+        auto* layout = new QVBoxLayout( m_widget );
+        layout->setContentsMargins( 32, 24, 32, 24 );
+        layout->setSpacing( 16 );
+
+        auto* stage = new QWidget( m_widget );
+        auto* stageLayout = new QGridLayout( stage );
+        stageLayout->setContentsMargins( 0, 0, 0, 0 );
+        auto* profiles = new QWidget( stage );
+        auto* profilesLayout = new QVBoxLayout( profiles );
+        profilesLayout->setContentsMargins( 0, 0, 0, 0 );
+        profilesLayout->setSpacing( 18 );
+        auto* blur = new QGraphicsBlurEffect( profiles );
+        blur->setBlurRadius( 10 );
+        blur->setBlurHints( QGraphicsBlurEffect::QualityHint );
+        profiles->setGraphicsEffect( blur );
+        profiles->setEnabled( false );
+        stageLayout->addWidget( profiles, 0, 0 );
+        layout->addWidget( stage, 1 );
+
+        auto* options = new QGroupBox( tr( "Alternative profile" ), profiles );
+        options->setObjectName( "advancedOptions" );
+        auto* optionsLayout = new QVBoxLayout( options );
+        auto* lite = new QCheckBox( tr( "Starch Lite (Special thanks to the Artix Linux team!)" ), options );
+        m_lite = lite;
+        lite->setObjectName( "starchLite" );
+        lite->setChecked( false );
+        // Public enablement requires verified package inputs and fresh-install testing.
+        lite->setEnabled( m_liteAvailable );
+        optionsLayout->addWidget( lite );
+        auto* xfce = new QCheckBox( tr( "Use Xfce instead of KDE Plasma (X11)" ), options );
+        m_xfce = xfce;
+        xfce->setObjectName( "starchLiteXfce" );
+        xfce->setEnabled( false );
+
+        connect( xfce, &QCheckBox::toggled, this, [this]() { saveSelection(); } );
+        auto* description = new QLabel(
+            tr( "Alternate config with a tuned zen kernel, openrc and a tuned KDE if you don't select xfce. "
+                "RAM usage can be as low as 700MB on Lite with xfce." ), options );
+        description->setWordWrap( true );
+        optionsLayout->addWidget( description );
+        auto* divider = new QFrame( options );
+        divider->setFrameShape( QFrame::HLine );
+        optionsLayout->addWidget( divider );
+        optionsLayout->addWidget( xfce );
+        if ( !m_liteAvailable )
+        {
+            auto* status = new QLabel(
+                tr( "Unavailable because the Starch Lite package bundle is missing." ), options );
+            status->setObjectName( "profileUnavailable" );
+            status->setWordWrap( true );
+            optionsLayout->addWidget( status );
+        }
+        profilesLayout->addWidget( options );
+        profilesLayout->addStretch();
+
+        auto* gate = new QFrame( stage );
+        gate->setObjectName( "advancedGate" );
+        gate->setMaximumWidth( 460 );
+        auto* gateLayout = new QVBoxLayout( gate );
+        gateLayout->setContentsMargins( 28, 28, 28, 28 );
+        gateLayout->setSpacing( 16 );
+        auto* notice = new QLabel( tr( "Advanced options" ), gate );
+        notice->setObjectName( "advancedGateTitle" );
+        notice->setAlignment( Qt::AlignCenter );
+        gateLayout->addWidget( notice );
+        auto* warning = new QLabel(
+            tr( "Only intended for advanced users. These options change core system components." ), gate );
+        warning->setWordWrap( true );
+        warning->setAlignment( Qt::AlignCenter );
+        gateLayout->addWidget( warning );
+        auto* skip = new QLabel(
+            tr( "You can skip this menu. Click Next to continue with the recommended defaults." ), gate );
+        skip->setWordWrap( true );
+        skip->setAlignment( Qt::AlignCenter );
+        gateLayout->addWidget( skip );
+        auto* acknowledge = new QCheckBox( tr( "I understand. Show advanced options." ), gate );
+        m_acknowledge = acknowledge;
+        acknowledge->setObjectName( "advancedAcknowledgement" );
+        gateLayout->addWidget( acknowledge, 0, Qt::AlignHCenter );
+        stageLayout->addWidget( gate, 0, 0, Qt::AlignCenter );
+        gate->raise();
+        connect( acknowledge, &QCheckBox::toggled, this, [this, profiles, blur, gate]( bool checked ) {
+            blur->setEnabled( !checked );
+            profiles->setEnabled( checked );
+            gate->setVisible( !checked );
+            if ( !checked ) m_lite->setChecked( false );
+            saveSelection();
+            if ( checked ) m_lite->setFocus( Qt::OtherFocusReason );
+        } );
+        connect( lite, &QCheckBox::toggled, this, [this]( bool checked ) {
+            m_xfce->setEnabled( checked );
+            if ( !checked ) m_xfce->setChecked( false );
+            saveSelection();
+        } );
+        saveSelection();
+    }
+    return m_widget;
+}
+
+void
+AdvancedViewStep::setConfigurationMap( const QVariantMap& configurationMap )
+{
+    Calamares::ViewStep::setConfigurationMap( configurationMap );
+    m_liteAvailable = configurationMap.value( "liteEnabled", false ).toBool();
+    if ( m_lite )
+    {
+        m_lite->setEnabled( m_liteAvailable );
+        if ( !m_liteAvailable ) m_lite->setChecked( false );
+    }
+    saveSelection();
+}
+
+void
+AdvancedViewStep::saveSelection()
+{
+    auto* storage = Calamares::JobQueue::instance()->globalStorage();
+    const bool acknowledged = m_acknowledge && m_acknowledge->isChecked();
+    storage->insert( "starchAdvancedAcknowledged", acknowledged );
+    const bool lite = acknowledged && m_liteAvailable && m_lite && m_lite->isChecked();
+    storage->insert( "starchLite", lite );
+    storage->insert( "starchLiteXfce", lite && m_xfce && m_xfce->isChecked() );
+}
+
+QString
+AdvancedViewStep::prettyStatus() const
+{
+    if ( m_liteAvailable && m_lite && m_lite->isChecked() && m_xfce && m_xfce->isChecked() )
+        return tr( "Starch Lite: Linux Zen, OpenRC and Xfce (X11), without KDE Plasma." );
+    if ( m_liteAvailable && m_lite && m_lite->isChecked() )
+        return tr( "Starch Lite: Linux Zen, OpenRC, Limine and KDE Plasma." );
+    return tr( "Standard Starch Linux: Linux LTS and systemd." );
+}
