/* Starch-owned Calamares presentation styling. */
#welcomeContent,
#installerContent {
    background-color: rgba(35, 38, 41, 220);
    border: 1px solid #3d5d73;
    border-radius: 8px;
    color: #eff0f1;
    padding: 16px;
}

#starchProfilesPage {
    background: transparent;
    color: palette(window-text);
}
#installationProfile {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 6px;
}
#installationProfile QLabel {
    border: none;
    background: transparent;
}
#installationProfile QRadioButton {
    spacing: 9px;
    font-size: 14px;
    font-weight: 600;
}
#profileUnavailable {
    color: #e06c75;
    font-weight: 600;
}
