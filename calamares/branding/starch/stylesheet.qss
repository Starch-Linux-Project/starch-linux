/* Starch-owned Calamares presentation styling. */
#welcomeContent,
#installerContent {
    background-color: rgba(35, 38, 41, 220);
    border: 1px solid #3d5d73;
    border-radius: 8px;
    color: #eff0f1;
    padding: 16px;
}

#starchSoftwarePage QLabel#softwareFieldTitle {
    font-size: 15px;
    font-weight: 600;
    padding-top: 6px;
}
#softwareTimeNote {
    font-weight: 600;
}
#starchSoftwarePage QPlainTextEdit {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 8px;
}
#starchSoftwarePage QPlainTextEdit:focus {
    border-color: palette(highlight);
}
